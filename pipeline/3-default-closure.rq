PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wds: <http://www.wikidata.org/entity/statement/>
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX ps: <http://www.wikidata.org/prop/statement/>
PREFIX pq: <http://www.wikidata.org/prop/qualifier/>
PREFIX : <https://github.com/bradleypallen/iss-rdf-wikidata/graph/>

# rule subclass-transitive
INSERT { GRAPH :default-closure { ?c wdt:P279 ?e } }
USING :asserted
USING :closure
USING :defaults
USING :default-closure
WHERE {
    ?c wdt:P279 ?d .
    ?d wdt:P279 ?e .
    FILTER NOT EXISTS { ?c wdt:P279 ?e }
} ;

# rule instance-through-subclass
INSERT { GRAPH :default-closure { ?x wdt:P31 ?d } }
USING :asserted
USING :closure
USING :defaults
USING :default-closure
WHERE {
    ?x wdt:P31 ?c .
    ?c wdt:P279 ?d .
    FILTER NOT EXISTS { ?x wdt:P31 ?d }
}
