# Generated by tools/make_pipeline.py from entries/entries.json. Do not edit.
# Step 2, for the report. The instances of default entries that apply at K.

PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wds: <http://www.wikidata.org/entity/statement/>
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX ps: <http://www.wikidata.org/prop/statement/>
PREFIX pq: <http://www.wikidata.org/prop/qualifier/>
PREFIX : <https://github.com/bradleypallen/iss-rdf-wikidata/graph/>

SELECT DISTINCT ?entry ?x ?y
FROM :asserted
FROM :closure
WHERE {
  { # entry p26-symmetric
    BIND("p26-symmetric" AS ?entry)
    ?x wdt:P26 ?y .
    FILTER NOT EXISTS {
      wd:P26 p:P2302 ?c .
      ?c ps:P2302 wd:Q21510862 .
      ?c pq:P2303 ?x .
    }
  }
  UNION
  { # entry p47-symmetric
    BIND("p47-symmetric" AS ?entry)
    ?x wdt:P47 ?y .
    FILTER NOT EXISTS {
      wd:P47 p:P2302 ?c .
      ?c ps:P2302 wd:Q21510862 .
      ?c pq:P2303 ?x .
    }
  }
}
ORDER BY ?entry ?x ?y
