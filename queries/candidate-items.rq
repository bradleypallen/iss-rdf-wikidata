# Label, classes and life dates of the items being considered for the
# hand-sized example. One row per item and class.
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX ps: <http://www.wikidata.org/prop/statement/>
PREFIX pq: <http://www.wikidata.org/prop/qualifier/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX bd: <http://www.bigdata.com/rdf#>

SELECT ?item ?itemLabel ?class ?classLabel ?birth ?death WHERE {
  VALUES ?item { wd:Q10556584 wd:Q240485 wd:Q63964937 wd:Q434292 wd:Q112829435 wd:Q364179 wd:Q1330110 wd:Q72936
                  wd:Q139464 wd:Q385468 wd:Q469726 wd:Q1158139 wd:Q338415 wd:Q226163
                  wd:Q2139951 wd:Q727175 wd:Q521435 wd:Q7186 wd:Q37463
                  wd:Q81810310 wd:Q1033 wd:Q118629252 wd:Q134675 wd:Q25855 }
  OPTIONAL { ?item wdt:P31 ?class }
  OPTIONAL { ?item wdt:P569 ?birth }
  OPTIONAL { ?item wdt:P570 ?death }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" }
}
ORDER BY ?item ?class
